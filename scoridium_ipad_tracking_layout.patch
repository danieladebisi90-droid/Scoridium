+
+/* iPad, phone and desktop: game.html owns the whole tracking workspace. */
+body.scoridium-shell.tracker-fullscreen {
+  padding:0!important; width:100%!important; height:100dvh!important; overflow:hidden!important;
+}
+body.scoridium-shell.tracker-fullscreen .shell-header,
+body.scoridium-shell.tracker-fullscreen .mobile-app-topbar,
+body.scoridium-shell.tracker-fullscreen .mobile-bottom-nav {display:none!important;}
+body.scoridium-shell.tracker-fullscreen .shell-main {
+  flex:1 1 auto!important; min-height:0!important; height:100%!important;
+  border-radius:0!important;
+}
+body.scoridium-shell.tracker-fullscreen #page-frame {width:100%!important;height:100%!important;}
--- a/court-rotation-fix.css
+++ b/court-rotation-fix.css
@@ -79,3 +79,19 @@
     flex-basis:160px!important; width:160px!important;
   }
 }
+
+/* iPad tracker: protect scoreboard from compact court-only rules. */
+html.focus-tracker .tracker-shell[data-focus-view] > .scoreboard {
+  flex:0 0 auto!important; height:auto!important; min-height:90px!important;
+  max-height:none!important; overflow:visible!important; padding:8px 14px!important;
+}
+html.focus-tracker .tracker-shell[data-focus-view] > .scoreboard .score-team output {
+  display:block!important; font-size:clamp(28px,4.4vw,54px)!important;
+  line-height:1.05!important; visibility:visible!important;
+}
+@media (max-height:620px){
+  html.focus-tracker .tracker-shell[data-focus-view] > .scoreboard {
+    min-height:72px!important; max-height:none!important; padding:4px 10px!important;
+  }
+  html.focus-tracker .tracker-shell[data-focus-view] > .scoreboard .score-team output {font-size:32px!important;}
+}
