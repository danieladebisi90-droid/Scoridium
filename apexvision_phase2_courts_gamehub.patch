+/* ApexVision Phase 2 — consistent compact zone SVG rendering. */
+.apex-zone-diagram{display:flex;flex-direction:column;min-width:0;gap:7px}
+.apex-zone-diagram>svg{width:100%!important;height:auto!important;max-height:420px;display:block}
+.apex-zone-caption{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12px;font-weight:800;color:var(--team-primary,#123b78)}
+.apex-zone-caption strong{font-size:15px}
+.apex-zone-empty{font-size:11px;margin:0;line-height:1.4}
+#player-zones .sc-player-zone-surface{width:100%;min-width:0;overflow:hidden}
+.opponent-courts-row>section .apex-zone-diagram{max-width:100%}
+
+/* ApexVision Phase 2 — desktop Game Hub always reserves stable space for
+   the calendar and keeps variable-length H2H content scrolling internally. */
+@media (min-width: 901px) and (min-height: 650px) {
+  html, body { min-height: 0; height: 100dvh; overflow: hidden; }
+  #app-content { flex: 1 1 auto; min-height: 0; overflow: hidden; }
+  .game-hub-layout { height: 100%; min-height: 0; overflow: hidden; }
+  .game-schedule { grid-template-rows: minmax(0, 0.48fr) minmax(0, 0.52fr); }
+  .game-info-container { grid-template-rows: minmax(0, 0.60fr) minmax(0, 0.40fr); }
+  .game-calendar, .games-list, .previous-game, .next-game { min-height: 0; overflow: hidden; }
+  .game-calendar { gap: 0; }
+  .game-calendar-header, .calendar-weekdays { flex: 0 0 auto; }
+  .calendar-weekdays { margin-top: 5px; margin-bottom: 3px; }
+  .calendar-dates { flex: 1 1 auto; grid-template-rows: repeat(6, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); }
+  .calendar-day { padding: 1px; }
+  #gamehub-context-container .gamehub-dynamic-context { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; scrollbar-width: thin; }
+  #gamehub-dynamic-context .sc-h2h-bars { gap: 4px; }
+  #gamehub-dynamic-context .sc-h2h-metric { padding: 4px 8px; border-radius: 6px; }
+  #gamehub-dynamic-context .sc-h2h-values { line-height: 1.15; }
+  #gamehub-dynamic-context .sc-h2h-track, #gamehub-dynamic-context .sc-h2h-full-track { height: 7px; margin-top: 3px; }
+  #gamehub-dynamic-context .gamehub-detailed-h2h { margin: 0; padding: 0; }
+}
