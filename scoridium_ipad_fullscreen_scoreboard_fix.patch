--- a/app-shell.css
+++ b/app-shell.css
@@ -41,3 +41,18 @@
   body.scoridium-shell.tracker-fullscreen .shell-main{height:100%;flex:1;min-height:0;border-radius:0!important}
   body.scoridium-shell.tracker-fullscreen #page-frame{height:100%;width:100%;display:block}
 }
+
+/* Full-screen tracker on iPad and every other display size. */
+body.scoridium-shell.tracker-fullscreen {
+  padding:0!important; height:100dvh!important; overflow:hidden!important;
+}
+body.scoridium-shell.tracker-fullscreen .shell-header,
+body.scoridium-shell.tracker-fullscreen .mobile-app-topbar,
+body.scoridium-shell.tracker-fullscreen .mobile-bottom-nav {display:none!important;}
+body.scoridium-shell.tracker-fullscreen .shell-main {
+  flex:1 1 auto!important; min-height:0!important; height:100%!important;
+  border-radius:0!important;
+}
+body.scoridium-shell.tracker-fullscreen #page-frame {
+  display:block!important; width:100%!important; height:100%!important;
+}
--- a/court-rotation-fix.css
+++ b/court-rotation-fix.css
@@ -79,3 +79,21 @@
     flex-basis:160px!important; width:160px!important;
   }
 }
+
+/* Keep the iPad scoreboard legible above the court, overriding
+   older 48px caps from collaboration-v2.css. */
+html.focus-tracker .tracker-shell[data-focus-view="court"] > .scoreboard {
+  flex:0 0 auto!important;
+  height:auto!important; min-height:104px!important; max-height:none!important;
+  overflow:visible!important; padding:8px 14px!important;
+}
+html.focus-tracker .tracker-shell[data-focus-view="court"] > .scoreboard .score-team output {
+  display:block!important; visibility:visible!important;
+  font-size:clamp(28px,4.4vw,52px)!important; line-height:1.05!important;
+}
+@media (max-height:620px) {
+  html.focus-tracker .tracker-shell[data-focus-view="court"] > .scoreboard {
+    min-height:82px!important; padding:4px 10px!important;
+  }
+  html.focus-tracker .tracker-shell[data-focus-view="court"] > .scoreboard .score-team output {font-size:32px!important;}
+}
